# ── Stripe checkout (server-side, used by /api/checkout on Vercel) ──────────
# Start with your TEST key (sk_test_…). Swap to sk_live_… only when you are
# ready to take real payments.
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: real Stripe Price IDs. When set, checkout uses these instead of
# the inline placeholder prices baked into api/checkout.ts
# (Core A$9,450 / Core + Overspeed A$9,990).
STRIPE_PRICE_ID_CORE=price_xxx
STRIPE_PRICE_ID_OVERSPEED=price_xxx
# Fallback single price (used for Core if STRIPE_PRICE_ID_CORE is unset).
STRIPE_PRICE_ID=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin for Stripe success/cancel redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://apexaustralia.vercel.app

# Inbox for "Book a Demo" / enquiry mailto links (inlined at build time).
NEXT_PUBLIC_CONTACT_EMAIL=you@yourdomain.com.au

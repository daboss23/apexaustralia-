# Inbox for the "Book a Demo" / enquiry mailto links (inlined at build time —
# see src/lib/site.ts). Set it in Vercel to route enquiries to the business
# inbox; without it the links fall back to the address in that file.
NEXT_PUBLIC_CONTACT_EMAIL=you@yourdomain.com.au

